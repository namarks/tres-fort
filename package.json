{
  "name": "lift-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply lift-coach-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lift-coach-db --remote",
    "release": "npm run db:migrate:remote && npm run deploy",
    "ios:testflight": "./scripts/upload-testflight.sh",
    "beta:feedback": "node scripts/beta-feedback-to-issues.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.9",
    "wrangler": "^4.0.0"
  }
}
